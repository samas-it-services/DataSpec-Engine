{
  "name": "@dataspec-engine/api",
  "version": "0.1.0",
  "description": "REST API service for DataSpec Engine - Express + Supabase Edge Functions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/express/server.ts",
    "start": "node dist/express/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "docker:build": "docker build -t dataspec-api .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "dataspec",
    "api",
    "express",
    "supabase",
    "edge-functions"
  ],
  "author": "SAMAS IT Services",
  "license": "ISC",
  "dependencies": {
    "@dataspec-engine/core": "*",
    "@dataspec-engine/supabase-adapter": "*",
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
}
