{
  "name": "@samas-it-services/dataspec-core",
  "version": "0.2.1",
  "description": "Core engine for DataSpec - YAML parsing, validation, transformation, masking",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-schema",
    "copy-schema": "cp src/parser/schema.json .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dataspec",
    "yaml",
    "validation",
    "transformation",
    "masking",
    "data-import",
    "data-export"
  ],
  "author": "SAMAS IT Services",
  "license": "ISC",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samas-it-services/DataSpec-Engine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/samas-it-services/DataSpec-Engine/issues"
  },
  "homepage": "https://github.com/samas-it-services/DataSpec-Engine/tree/main/packages/core#readme",
  "dependencies": {
    "yaml": "^2.4.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "date-fns": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
